# Copy this file to .env.local and fill in the values.
# NEVER commit real secrets (.env* is gitignored).

# ---- Required ----
# Groq API key for AI analysis and draft generation
GROQ_API_KEY=

# ---- Optional ----
# Groq model (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Auth (Clerk)
# "true" enables Clerk auth. "false" skips auth (demo mode — no Clerk JS loads,
# the app is fully open). NEXT_PUBLIC_AUTH_ENABLED must mirror AUTH_ENABLED.
# Keys from https://dashboard.clerk.com → API Keys
AUTH_ENABLED=false
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Custom auth routes (the app has a single branded /login page; mode=signup toggles)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login?mode=signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Instagram Graph API — set these to enable live sync, or INSTAGRAM_DEMO=true for a sandboxed demo
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_DEMO=true

# Rotating proxy for scraping on serverless hosts (Vercel blocks datacenter IPs).
# Supported formats (replace KEY with your key):
#   ScraperAPI:   https://scraperapi.com/api/v1?api_key=KEY&url={url}&country_code=us
#   ZenRows:      https://api.zenrows.com/v1/?apikey=KEY&url={url}
#   ScrapingBee:  https://app.scrapingbee.com/api/v1/?api_key=KEY&url={url}
SCRAPE_PROXY_URL=

# Hosted browser rendering for profile scraping on serverless hosts (Vercel)
# where Instagram blocks datacenter IPs. Sign up at firecrawl.dev (free 500
# credits/month), create an API key, and set it here. ~1 credit per profile.
FIRECRAWL_API_KEY=

# Public base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Prisma (in .env, not .env.local) ----
# Local: file:./dev.db
# Vercel/Turso: libsql://<your-db>.turso.io  + TURSO_AUTH_TOKEN (from `turso db tokens create <db>`)
# DATABASE_URL=file:./dev.db
# TURSO_AUTH_TOKEN=
