# Copy this file to .env.local and fill in the values.
# NEVER commit real secrets (.env* is gitignored).

# ---- Required ----
# Groq API key for AI analysis and draft generation
GROQ_API_KEY=

# ---- Optional ----
# Groq model (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Auth
# "true" enables NextAuth (Google). "false" skips auth locally (dev convenience).
AUTH_ENABLED=false
AUTH_SECRET=
# Google OAuth — set these to enable "Continue with Google"
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Instagram Graph API — set these to enable live sync, or INSTAGRAM_DEMO=true for a sandboxed demo
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_DEMO=true

# Public base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Prisma (in .env, not .env.local) ----
# DATABASE_URL=file:./dev.db
