# Copy this file to .env.local and fill in the values.
# NEVER commit real secrets (.env* is gitignored).

# ---- Required ----
# Groq API key for AI analysis and draft generation
GROQ_API_KEY=

# ---- Optional ----
# Groq model (defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Auth
# "true" enables NextAuth (Google). "false" skips auth locally (dev convenience).
AUTH_ENABLED=false
AUTH_SECRET=
# Google OAuth — set these to enable "Continue with Google"
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Instagram Graph API — set these to enable live sync, or INSTAGRAM_DEMO=true for a sandboxed demo
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_DEMO=true

# Rotating proxy for scraping on serverless hosts (Vercel blocks datacenter IPs).
# Supported formats (replace KEY with your key):
#   ScraperAPI:   https://scraperapi.com/api/v1?api_key=KEY&url={url}&country_code=us
#   ZenRows:      https://api.zenrows.com/v1/?apikey=KEY&url={url}
#   ScrapingBee:  https://app.scrapingbee.com/api/v1/?api_key=KEY&url={url}
SCRAPE_PROXY_URL=

# Hosted Instagram scraper for serverless hosts (Vercel) where Instagram
# blocks datacenter IPs. Sign up at apify.com (free $5 credit), create an
# API token, and set it here:
APIFY_TOKEN=
# Optional: override the actor (default apify/instagram-scraper)
APIFY_ACTOR_ID=

# Public base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Prisma (in .env, not .env.local) ----
# Local: file:./dev.db
# Vercel/Turso: libsql://<your-db>.turso.io  + TURSO_AUTH_TOKEN (from `turso db tokens create <db>`)
# DATABASE_URL=file:./dev.db
# TURSO_AUTH_TOKEN=
